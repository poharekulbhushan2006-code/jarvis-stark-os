# ===============================================
# JARVIS CONFIGURATION
# ===============================================

# Google Gemini API Key (Optional but recommended for full conversational AI)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Jarvis Persona & Voice Settings
# Voices: en-GB-RyanNeural (Jarvis), en-GB-ThomasNeural, en-US-ChristopherNeural
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_SPEECH_RATE=+0%
JARVIS_PITCH=+0Hz

# User Name
USER_NAME=Sir

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False
